{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product_master.schema.json",
  "title": "Amazon Product OS Product Master",
  "type": "object",
  "required": [
    "product_name", "sku", "quantity", "color", "material", "dimensions",
    "weight_g", "packaging", "target_audience", "core_functions", "compliance", "initial_inventory"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "product_name": {"type": "string", "minLength": 1},
    "sku": {"type": "string", "minLength": 1},
    "quantity": {"type": "string", "minLength": 1},
    "color": {"type": "string", "minLength": 1},
    "material": {"type": "string", "minLength": 1},
    "dimensions": {"type": "object"},
    "weight_g": {"type": "number", "exclusiveMinimum": 0},
    "packaging": {"type": "string", "minLength": 1},
    "target_audience": {"type": "string", "minLength": 1},
    "core_functions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "compliance": {"type": "object"},
    "brand": {"type": "string"},
    "ean": {"type": "string"},
    "manufacturer": {"type": "string"},
    "responsible_person": {"type": "string"},
    "country_of_origin": {"type": "string"},
    "target_price": {"type": ["number", "null"]},
    "currency": {"type": "string"},
    "initial_inventory": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
