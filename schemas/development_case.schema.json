{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "development_case.schema.json",
  "title": "Amazon Product OS Development Case",
  "type": "object",
  "required": ["candidate", "market", "development_plan", "supply_chain", "profit_inputs", "compliance_profile"],
  "properties": {
    "candidate": {"$ref": "candidate.schema.json"},
    "market": {"type": "object"},
    "development_plan": {"type": "object"},
    "supply_chain": {"type": "object"},
    "profit_inputs": {"type": "object"},
    "compliance_profile": {"type": "object"},
    "recommended_marketplaces": {"type": "array", "items": {"type": "string"}},
    "recommended_price": {"type": "object"},
    "target_purchase_price_cny": {"type": "number"},
    "minimum_conservative_margin": {"type": "number"},
    "largest_risks": {"type": "array", "items": {"type": "string"}},
    "evidence_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}

