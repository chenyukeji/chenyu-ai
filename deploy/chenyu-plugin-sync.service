[Unit]
Description=Synchronize Chenyu AI plugins from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/chenyu/chenyu-ai
Environment=HOME=/home/ubuntu
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/ubuntu/chenyu/chenyu-ai/scripts/sync_remote_plugins.py
